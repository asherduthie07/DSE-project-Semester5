{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.0.0/schema.json",
  "name": "stroke_outcome_chart",
  "position": {
    "x": 290,
    "y": 20,
    "z": 6,
    "width": 450,
    "height": 280,
    "tabOrder": 6
  },
  "visual": {
    "visualType": "clusteredColumnChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "stroke_outcomes"
                    }
                  },
                  "Property": "category"
                }
              },
              "queryRef": "stroke_outcomes.category",
              "nativeQueryRef": "category"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "stroke_outcomes"
                    }
                  },
                  "Property": "Total count"
                }
              },
              "queryRef": "stroke_outcomes.Total count",
              "nativeQueryRef": "Total count"
            }
          ]
        }
      }
    }
  }
}
