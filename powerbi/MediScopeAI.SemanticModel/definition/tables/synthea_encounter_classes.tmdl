table synthea_encounter_classes
	column dataset_id
		dataType: string
		sourceColumn: dataset_id
		summarizeBy: none

	column group
		dataType: string
		sourceColumn: group
		summarizeBy: none

	column feature
		dataType: string
		sourceColumn: feature
		summarizeBy: none

	column category
		dataType: string
		sourceColumn: category
		summarizeBy: none

	column count
		dataType: int64
		sourceColumn: count
		summarizeBy: none

	column nonmissing_n
		dataType: int64
		sourceColumn: nonmissing_n
		summarizeBy: none

	column all_n
		dataType: int64
		sourceColumn: all_n
		summarizeBy: none

	column pct_all
		dataType: double
		sourceColumn: pct_all
		summarizeBy: none

	column pct_nonmissing
		dataType: double
		sourceColumn: pct_nonmissing
		summarizeBy: none

	measure 'Total count' = SUM(synthea_encounter_classes[count])
		formatString: #,##0

	partition synthea_encounter_classes = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "\synthea_encounter_classes.csv"), [Delimiter=",", Columns=9, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				Typed = Table.TransformColumnTypes(Nulls, {{"dataset_id", type text}, {"group", type text}, {"feature", type text}, {"category", type text}, {"count", Int64.Type}, {"nonmissing_n", Int64.Type}, {"all_n", Int64.Type}, {"pct_all", type number}, {"pct_nonmissing", type number}}, "en-US")
			in Typed
