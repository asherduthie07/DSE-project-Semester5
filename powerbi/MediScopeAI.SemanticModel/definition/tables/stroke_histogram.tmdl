table stroke_histogram
	column dataset_id
		dataType: string
		sourceColumn: dataset_id
		summarizeBy: none

	column feature
		dataType: string
		sourceColumn: feature
		summarizeBy: none

	column outcome
		dataType: string
		sourceColumn: outcome
		summarizeBy: none

	column bin_start
		dataType: double
		sourceColumn: bin_start
		summarizeBy: none

	column bin_end
		dataType: double
		sourceColumn: bin_end
		summarizeBy: none

	column bin_label
		dataType: string
		sourceColumn: bin_label
		summarizeBy: none

	column count
		dataType: int64
		sourceColumn: count
		summarizeBy: none

	column nonmissing_group_n
		dataType: string
		sourceColumn: nonmissing_group_n
		summarizeBy: none

	measure 'Total count' = SUM(stroke_histogram[count])
		formatString: #,##0

	partition stroke_histogram = m
		mode: import
		source =
			let
				Source = Csv.Document(File.Contents(DataRoot & "\histogram_bins.csv"), [Delimiter=",", Columns=8, Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
				Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				Nulls = Table.ReplaceValue(Headers, "", null, Replacer.ReplaceValue, Table.ColumnNames(Headers)),
				Typed = Table.TransformColumnTypes(Nulls, {{"dataset_id", type text}, {"feature", type text}, {"outcome", type text}, {"bin_start", type number}, {"bin_end", type number}, {"bin_label", type text}, {"count", Int64.Type}, {"nonmissing_group_n", type text}}, "en-US"),
				Filtered = Table.SelectRows(Typed, each [dataset_id] = "kaggle_stroke")
			in Filtered
